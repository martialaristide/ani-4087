from Jenga import *

with workspace("PremierSon"):
    configurations(["Release"])
    useconfig("Kits/R3D/R3D.jenga")

    with project("premier-son"):
        consoleapp()
        language("C++")
        cppdialect("C++17")
        files(["premier-son.cpp"])
        cxxflags(["-stdlib=libc++"])
        ldflags(["-stdlib=libc++"])
        user3d(modules=["NKAudio"])

        with filter("config:Release"):
            optimize("Speed")
            symbols(False)
